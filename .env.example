# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/aice_exchange

# Set to "true" if your DB host requires SSL (e.g. Railway, Supabase, Render)
DATABASE_SSL=false

# ── Anthropic ────────────────────────────────────────────────────────────────
# Server-side only — NEVER expose this to the browser
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# How often the tick engine fires (seconds).  30 = one tick every 30s.
# During market hours (weekdays 9:30am–4pm) this advances prices.
# Outside hours the cron fires but the tick is skipped.
TICK_SECONDS=30

# ── Security ─────────────────────────────────────────────────────────────────
# Secret key for admin endpoints (POST /api/market/tick, POST /api/market/reset)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=replace_with_a_long_random_string

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://eplchronicles.com,http://localhost:3000

# NODE_ENV: set to "production" to suppress per-tick console logs
NODE_ENV=production
